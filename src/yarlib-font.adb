   function Source (C : Character) return Rectangle is
      Index : constant Natural :=
        Character'Pos (C) - Character'Pos (' ');
      Column : constant Natural := Index mod 16;
      Row    : constant Natural := Index / 16;
   begin
      return
        (X      => Scalar (Column * Glyph_Width),
         Y      => Scalar (Row * Glyph_Height),
         Width  => Scalar (Glyph_Width),
         Height => Scalar (Glyph_Height));
   end Source;

   function Build_Atlas return Bitmap is
      Img : Bitmap :=
        Bedrock.Buffers.Make (Atlas_Width, Atlas_Height);
      R : Rectangle;
   begin
      for C in Bits'Range loop
         R := Source (C);

         for Y in 0 .. Glyph_Height - 1 loop
            for X in 0 .. Glyph_Width - 1 loop
               if (Bits (C) (Y) / (2 ** (Glyph_Width - 1 - X))) mod 2 = 1 then
                  Bedrock.Buffers.Set
                    (Img,
                     Natural (R.X) + X,
                     Natural (R.Y) + Y,
                     White);
               end if;
            end loop;
         end loop;
      end loop;

      return Img;
   end Build_Atlas;

