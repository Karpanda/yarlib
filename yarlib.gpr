with "bedrock";

library project Yarlib is

   type Platform_Kind is ("null", "sdl3");
   type Renderer_Kind is ("software", "opengl");
   Platform : Platform_Kind := external ("YARLIB_PLATFORM", "null");
   Renderer : Renderer_Kind := external ("YARLIB_RENDERER", "software");
   type OS_Kind is ("linux", "macos", "windows");
   OS : OS_Kind := external ("YARLIB_OS", "linux");
   --  Set by alire.toml from the host OS. Only the link line depends on
   --  it: the OpenGL library has a different name on each OS.
   --  null/software needs nothing and is what the tests use: no window,
   --  frames rendered into memory and readable back.
   --  sdl3/opengl is a game on screen: needs SDL3 and an OpenGL driver.
   --  sdl3/software is a window with the software renderer (milestone 6
   --  adds the Present hook the platform needs for it, and the portal
   --  port that makes the whole path Ada).

   for Library_Name use "yarlib";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";

   for Source_Dirs use ("src", "ports/platform/" & Platform, "ports/renderer/" & Renderer);
   for Object_Dir use "obj/" & Platform & "-" & Renderer;
   for Library_Dir use "lib/" & Platform & "-" & Renderer;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O2", "-fstack-check");
      --  The rasterizer's inner loop is float arithmetic per pixel;
      --  -gnatVa (validity checks on every float read) makes it 25x
      --  slower, 220 ms for a full-screen quad. Measured, not guessed.
      --  Everything else keeps the checks.
      for Switches ("yarlib-raster.adb") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVn",
         "-gnatyg", "-gnatyM100", "-g", "-O2", "-fstack-check");
   end Compiler;

   package Linker is
      Libs := ();
      case Platform is
         when "sdl3" =>
            case OS is
               when "macos" =>
                  --  Homebrew is outside the default search path:
                  --  /opt/homebrew on Apple Silicon, /usr/local on Intel.
                  Libs := Libs & ("-L/opt/homebrew/lib", "-L/usr/local/lib", "-lSDL3");
               when others =>
                  Libs := Libs & ("-lSDL3");
            end case;
         when others => null;
      end case;
      case Renderer is
         when "opengl" =>
            case Platform is
               when "sdl3" =>
                  case OS is
                     when "linux"   => Libs := Libs & ("-lGL");
                     when "windows" => Libs := Libs & ("-lopengl32");
                     when "macos"   =>
                        --  No libGL on macOS: OpenGL is a framework. One
                        --  token, so gprbuild cannot split or reorder it.
                        Libs := Libs & ("-Wl,-framework,OpenGL");
                  end case;
               when others => null;
            end case;
         when others => null;
      end case;
      for Linker_Options use Libs;
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "-j0");
   end Prove;

end Yarlib;
